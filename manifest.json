{
	"manifest_version": 3,
	"name": "Pin Sniper",
	"version": "3.0",
	"description": "Downloads boards, Images, GIFs, & Videos from Pinterest.",
	"browser_specific_settings": {
		"gecko": {
			"id": "pinsniper-companion@yourdomain.com",
			"strict_min_version": "142.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"permissions": [
		"activeTab",
		"scripting",
		"downloads",
		"declarativeNetRequest"
	],
	"host_permissions": [
		"*://*.pinimg.com/*",
		"*://*.pinterest.com/*",
		"http://127.0.0.1:31337/*"
	],
	"icons": {
		"512": "icon.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"512": "icon.png"
		}
	},
	"background": {
		"scripts": [ "background.js" ]
	},
	"declarative_net_request": {
		"rule_resources": [
			{
				"id": "cors_bypass",
				"enabled": true,
				"path": "rules.json"
			}
		]
	},
	"content_scripts": [
		{
			"matches": [ "*://*.pinterest.com/*" ],
			"js": [ "hls.js" ]
		}
	]
}

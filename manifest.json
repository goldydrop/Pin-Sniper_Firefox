{
	"manifest_version": 3,
	"name": "Pin Sniper",
	"version": "3.0",
	"description": "Downloads boards, Images, GIFs, & Videos from Pinterest.",
	"browser_specific_settings": {
		"gecko": {
			"id": "pinsniper-companion@yourdomain.com",
			"strict_min_version": "142.0"
		}
	},
	"permissions": [
		"activeTab",
		"scripting"
	],
	"host_permissions": [
		"*://*.pinimg.com/*",
		"*://*.pinterest.com/*",
		"http://127.0.0.1:31337/*"
	],
	"icons": {
		"16": "icon.png",
		"48": "icon.png",
		"128": "icon.png",
		"512": "icon.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icon.png",
			"48": "icon.png",
			"128": "icon.png",
			"512": "icon.png"
		}
	},
	"background": {
		"scripts": [ "background.js" ]
	},
	"content_scripts": [
		{
			"matches": [ "*://*.pinterest.com/*" ],
			"js": [ "scraper.js" ]
		}
	]
}
